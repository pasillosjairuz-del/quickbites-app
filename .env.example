VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Demo mode: shows sample menu data when Supabase is unreachable AND bypasses the auth guards, so the UI can be viewed without a backend. Dev/demo only; keep false in production.
VITE_DEMO_MODE=false
# Public URL of the deployed web app (no trailing slash). Used for emailed links such as password reset, which would otherwise point at localhost inside the Android app.
VITE_APP_URL=
